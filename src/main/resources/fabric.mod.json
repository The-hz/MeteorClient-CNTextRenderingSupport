{
  "schemaVersion": 1,
  "id": "meteor-client-cn-text-rendering-support",
  "version": "${version}",
  "name": "CNTextRenderingSupportPlugin",
  "description": "An addon for Meteor Client to support Chinese text rendering.",
  "authors": [
    "The-hz"
  ],
  "contact": {
    "repo": "https://github.com/The-hz/MeteorClient-CNTextRenderingSupport"
  },
  "icon": "assets/cjkfix/icon.png",
  "environment": "client",
  "entrypoints": {
    "meteor": [
      "com.cjkfix.CJKFixLoader"
    ]
  },
  "mixins": [
    "meteor-client-cn-text-rendering-support.mixins.json"
  ],
  "custom": {
    "meteor-client:color": "135,206,235"
  },
  "depends": {
    "java": ">=21",
    "minecraft": ["${mc_version}"],
    "meteor-client": "*"
  }
}
