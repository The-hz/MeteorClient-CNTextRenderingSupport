{
  "schemaVersion": 1,
  "id": "meteor-client-cn-text-rendering-support",
  "version": "${version}",
  "name": "Meteor Client CN Text Rendering Support",
  "description": "An addon for Meteor Client to support Chinese text rendering.",
  "authors": [
    "The-hz"
  ],
  "contact": {
    "repo": "https://github.com/MeteorDevelopment/meteor-client-cn-text-rendering-support"
  },
  "icon": "assets/template/icon.png",
  "environment": "client",
  "entrypoints": {
    "meteor": [
      "com.cjkfix.addon.CJKFixLoader"
    ]
  },
  "mixins": [
    "addon-template.mixins.json"
  ],
  "custom": {
    "meteor-client:color": "225,25,25"
  },
  "depends": {
    "java": ">=21",
    "minecraft": ["${mc_version}"],
    "meteor-client": "*"
  }
}
